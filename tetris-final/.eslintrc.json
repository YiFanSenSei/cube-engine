{
  "env": {
    "browser": true,
    "es2020": true,
    "node": true
  },
  "globals": {
    "Renderer": "readonly",
    "CoopRenderer": "readonly",
    "TetrisGame": "readonly",
    "COLORS": "readonly",
    "COLOR_GLOW": "readonly",
    "SHAPES": "readonly",
    "BLOCK_SKIN_COLORS": "readonly",
    "BLOCK_SKIN_GLOWS": "readonly",
    "THEMES": "readonly",
    "SHOP_UI_SKINS": "readonly",
    "SHOP_BLOCK_SKINS": "readonly",
    "THEME_ACCENT_RGB": "readonly",
    "playerGame": "readonly",
    "aiGame": "readonly",
    "playerRenderer": "readonly",
    "aiRenderer": "readonly",
    "coopRenderer": "readonly",
    "gameMode": "writable",
    "running": "writable",
    "gameStarted": "writable",
    "isReplayMode": "writable",
    "animFrameId": "writable",
    "customSkinDataUrl": "writable",
    "customBgDataUrl": "writable",
    "customBgActive": "writable",
    "equippedItems": "writable",
    "ownedItems": "writable",
    "shopTab": "writable",
    "mySkinsTab": "writable",
    "currentTheme": "writable",
    "brightnessMode": "writable",
    "menuMode": "writable",
    "aiDifficulty": "writable",
    "audioSettings": "writable",
    "replayTimer": "writable",
    "challengeTimerInterval": "writable",
    "capturingActionId": "writable",
    "customTexturePattern": "writable",
    "textureSkinActive": "writable",
    "showShopNotification": "readonly",
    "refreshDecorBlocks": "readonly",
    "addParticles": "readonly",
    "toggleShopPanel": "readonly",
    "renderShopItems": "readonly",
    "saveShopData": "readonly",
    "applyBlockSkin": "readonly",
    "renderMySkins": "readonly",
    "applyCustomBg": "readonly"
  },
  "parserOptions": {
    "ecmaVersion": 2020
  },
  "rules": {
    "eqeqeq": ["error", "always"],
    "no-var": "error",
    "prefer-const": "warn",
    "no-undef": "error",
    "no-unused-vars": ["warn", { "args": "none", "varsIgnorePattern": "^_" }],
    "no-trailing-spaces": "warn",
    "no-duplicate-imports": "error",
    "prefer-template": "warn",
    "no-useless-rename": "warn"
  }
}