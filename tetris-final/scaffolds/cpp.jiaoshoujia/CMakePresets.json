{
    "version": 8,
    "configurePresets": [
        {
            "name": "msvc-debug",
            "displayName": "MSVC Debug (x64)",
            "description": "使用 Visual Studio 2022 MSVC x64 调试构建",
            "generator": "Visual Studio 17 2022",
            "architecture": {
                "value": "x64",
                "strategy": "set"
            },
            "binaryDir": "${sourceDir}/build/msvc-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_TESTS": "ON",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
            }
        },
        {
            "name": "msvc-release",
            "displayName": "MSVC Release (x64)",
            "description": "使用 Visual Studio 2022 MSVC x64 发布构建",
            "generator": "Visual Studio 17 2022",
            "architecture": {
                "value": "x64",
                "strategy": "set"
            },
            "binaryDir": "${sourceDir}/build/msvc-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_TESTS": "ON",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
            }
        },
        {
            "name": "ninja-msvc-debug",
            "displayName": "Ninja MSVC Debug",
            "description": "使用 Ninja + MSVC 快速调试构建",
